# /etc/systemd/system/proxmox-gui-worker.service
# Phase 3: arq is now wired — the ExecStart below runs the arq worker.
# D-17 — three systemd units inside the LXC; this is the worker unit.
# It depends on the embedded redis-server (loopback-bound, 4th runtime service).

[Unit]
Description=Proxmox GUI Worker (arq)
After=network-online.target proxmox-gui-api.service redis-server.service
Wants=network-online.target
Requires=redis-server.service

[Service]
Type=simple
User=proxmox-gui
Group=proxmox-gui
# DEPLOY-04: WorkingDirectory + ExecStart resolve through /opt/proxmox-gui/current,
# a symlink swapped atomically by deploy/lxc/update.sh. The per-release venv
# lives inside the release dir so the worker rebases onto the new release
# only when it is restarted LAST by run_self_update (after the health check
# of the api on the new release passes).
WorkingDirectory=/opt/proxmox-gui/current/backend
Environment=PROXMOX_GUI_MASTER_KEY_PATH=/etc/proxmox-gui/master.key
Environment=PROXMOX_GUI_DATABASE_URL=sqlite+aiosqlite:////var/lib/proxmox-gui/app.db
ExecStart=/opt/proxmox-gui/current/.venv/bin/arq app.jobs.worker.WorkerSettings
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# hardening (ASVS V14.1) — matches the api unit
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/proxmox-gui /var/log/proxmox-gui

[Install]
WantedBy=multi-user.target
