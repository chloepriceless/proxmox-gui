# /etc/systemd/system/proxmox-gui-worker.service
# Phase 3: arq is now wired — the ExecStart below runs the arq worker.
# D-17 — three systemd units inside the LXC; this is the worker unit.
# It depends on the embedded redis-server (loopback-bound, 4th runtime service).

[Unit]
Description=Proxmox GUI Worker (arq)
After=network-online.target proxmox-gui-api.service redis-server.service
Wants=network-online.target
Requires=redis-server.service

[Service]
Type=simple
User=proxmox-gui
Group=proxmox-gui
WorkingDirectory=/opt/proxmox-gui/backend
Environment=PROXMOX_GUI_MASTER_KEY_PATH=/etc/proxmox-gui/master.key
Environment=PROXMOX_GUI_DATABASE_URL=sqlite+aiosqlite:////var/lib/proxmox-gui/app.db
ExecStart=/opt/proxmox-gui/.venv/bin/arq app.jobs.worker.WorkerSettings
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# hardening (ASVS V14.1) — matches the api unit
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/proxmox-gui /var/log/proxmox-gui

[Install]
WantedBy=multi-user.target
