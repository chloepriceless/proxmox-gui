# Proxmox Self-Service GUI — backend environment template.
# Every variable is namespaced under PROXMOX_GUI_*. Copy to .env (gitignored) for local dev.

# Path to the 32-byte master key file used by SecretCipher (Fernet wrapper).
# In production this is created by the installer at mode 0400, owned by the proxmox-gui service user.
# For local dev you can use any 32-byte file (e.g. `dd if=/dev/urandom of=./master.key bs=32 count=1`).
PROXMOX_GUI_MASTER_KEY_PATH=/etc/proxmox-gui/master.key

# SQLAlchemy async DB URL. Default: ./app.db (SQLite WAL mode).
PROXMOX_GUI_DATABASE_URL=sqlite+aiosqlite:///./app.db

# JWT signing secret. In prod the installer writes a 48+ byte secret to a file and
# points PROXMOX_GUI_JWT_SECRET_FILE at it. For dev you may inline PROXMOX_GUI_JWT_SECRET.
# If neither is set the app generates an ephemeral secret and emits a warning (DEV ONLY).
PROXMOX_GUI_JWT_SECRET_FILE=/etc/proxmox-gui/jwt.secret
# PROXMOX_GUI_JWT_SECRET=replace-me-with-a-long-random-string

# PAT pepper. Mixed into PAT hashes; rotating it invalidates all live PATs.
PROXMOX_GUI_PAT_PEPPER_FILE=/etc/proxmox-gui/pat.pepper
# PROXMOX_GUI_PAT_PEPPER=replace-me-with-a-long-random-string

# SQLAlchemy echo (verbose query logging). Set to true for debugging.
PROXMOX_GUI_SQL_ECHO=false

# Cookie hardening flags.
# Set cookie_secure=false ONLY for local dev over plain HTTP (loopback).
# In prod the installer + Caddy guarantee HTTPS, so leave at true.
PROXMOX_GUI_COOKIE_SECURE=true
PROXMOX_GUI_COOKIE_SAMESITE=lax

# Token TTLs in seconds. Defaults: 15-min access, 7-day refresh.
PROXMOX_GUI_ACCESS_TOKEN_TTL_SECONDS=900
PROXMOX_GUI_REFRESH_TOKEN_TTL_SECONDS=604800

# CSRF cookie name (JS-readable; double-submit pattern).
PROXMOX_GUI_CSRF_COOKIE_NAME=csrf_token

# Log level for structlog / uvicorn.
PROXMOX_GUI_LOG_LEVEL=INFO
