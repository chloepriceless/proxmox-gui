# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Local config — must never be committed
.env
.env.local
*.local

# SQLite databases (dev only; production lives at /var/lib/proxmox-gui/app.db)
*.db
*.db-journal
*.db-wal
*.db-shm

# Secrets — defense-in-depth (these belong in /etc/proxmox-gui, never in repo)
master.key
jwt.secret
pat.pepper
*.key
*.secret
*.pepper

# LXC + Proxmox artifacts (templates, dumps)
*.tar.zst

# IDE
.vscode/
.vscode/settings.json
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Node (frontend)
node_modules/
.svelte-kit/
dist/

# Build outputs:
#  - generic `build/` ignored (test fixtures, scratch builds)
#  - frontend/build/ EXPLICITLY tracked: committed adapter-node artefact
#    so the install LXC never runs pnpm/vite (Plan 01-04 follow-up)
build/
!frontend/build/
!frontend/build/**
